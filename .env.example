# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_PASSCODE: Passcode required to unlock the Admin Panel.
# If left empty in preview, the Admin Panel offers a one-time first-run passcode setup.
ADMIN_PASSCODE=

# TELEGRAM_BOT_USERNAME: Public Telegram bot username (without @) for referral links.
TELEGRAM_BOT_USERNAME="moneyxearnbot"

# TELEGRAM_BOT_TOKEN: Telegram Bot API token for live getChatMember verification and /start bot replies.
TELEGRAM_BOT_TOKEN=

# TELEGRAM_WEBHOOK_SECRET: Optional secret token configured on Telegram setWebhook to authenticate webhook updates.
TELEGRAM_WEBHOOK_SECRET=
